{
  "extends": "@vill-v/tsconfig/base.json",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts", "docs/.vitepress/**/*.ts"],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/.nuxt",
    "**/.output",
    "**/.turbo",
    "docs/.vitepress/cache"
  ]
}
