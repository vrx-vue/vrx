  },
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "sideEffects": false,
  "repository": "https://github.com/vrx-vue/vrx.git",
  "scripts": {
    "build": "automd && turbo run build",
    "release": "vbumpp -r && pnpm build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "clean:dist": "pnpm dlx void-fs del packages/*/dist",
    "clean:docs": "pnpm dlx void-fs del docs/.vitepress/dist",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal docs/public/favicon.svg"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@shikijs/vitepress-twoslash": "^4.6.0",
    "@types/node": "^26.6.6",
    "@vill-v/bumpp-github": "^6.3.0",
    "@vill-v/eslint-config": "^3.2.1",
    "@vill-v/prettier-config": "^1.0.0",
    "@vill-v/tsconfig": "^2.0.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/vitepress": "^2.0.3",
    "@vrx/core": "workspace:*",
    "@vrx/nuxt": "workspace:*",
    "automd": "^0.4.3",
    "eslint": "^9.26.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "nuxt": "^4.6.4",
    "prettier": "^3.5.3",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "tsx": "^4.19.4",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "unocss": "^66.12.0",
    "unplugin-unused": "^0.6.0",
    "vitepress": "^2.0.0-alpha.21",
    "void-fs": "^0.0.1-beta.18",
    "vue": "^3.5.45",
    "workbox-window": "^7.4.1"
  },
  "peerDependencyRules": {
    "ignoreMissing": [
      "@algolia/client-search"
    ]
  }
